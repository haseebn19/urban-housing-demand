# Required: there is no default, for security
DB_PASSWORD=your_secure_password_here

# Optional (defaults shown)
DB_DATABASE=urban_housing_demand
DB_USER=root

# Optional: key for the external data API. Without it, the ingestor loads the seed data.
# API_KEY=your_api_key_here

# Deployment with compose.deploy.yaml: the domain to get an HTTPS certificate for
# DOMAIN_URL=example.com
# Optional: true uses Let's Encrypt test certificates while setting up
# STAGING=false
